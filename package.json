{
  "name": "mcp-ob-ts",
  "version": "0.3.2",
  "description": "OB3 MCP Server — exposes Open Badges 3.0 vocabulary to coding agents",
  "type": "module",
  "main": "dist/cli.js",
  "bin": {
    "mcp-ob-ts": "dist/cli.js"
  },
  "files": [
    "dist/",
    "data/sources.json",
    "data/snapshots/",
    "data/index.db",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "start": "node dist/cli.js",
    "lint": "biome check src/ scripts/ tests/",
    "lint:fix": "biome check --write src/ scripts/ tests/",
    "format": "biome format --write src/ scripts/ tests/",
    "test": "vitest --run",
    "test:smoke": "tsx scripts/smoke-test-pack.ts",
    "inspect": "npx @modelcontextprotocol/inspector node dist/cli.js",
    "data:fetch": "tsx scripts/fetch-spec-data.ts",
    "data:ingest": "tsx scripts/ingest-spec.ts",
    "changeset": "changeset",
    "prepare": "husky"
  },
  "keywords": [
    "mcp",
    "open-badges",
    "ob3"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.14.0",
  "dependencies": {
    "@faker-js/faker": "^10.6.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "cheerio": "^1.2.0",
    "jsonld": "^9.0.0",
    "n3": "^2.2.0",
    "sql.js": "^1.14.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@changesets/cli": "^3.0.0",
    "@types/jsonld": "^1.5.15",
    "@types/n3": "^1.26.1",
    "@types/node": "^26.2.0",
    "@types/sql.js": "^1.4.11",
    "fast-check": "^4.9.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx,js,jsx}": [
      "biome check --write"
    ],
    "scripts/**/*.{ts,tsx,js,jsx}": [
      "biome check --write"
    ],
    "tests/**/*.{ts,tsx,js,jsx}": [
      "biome check --write"
    ]
  },
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maxxeddev/open-badges-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/maxxeddev/open-badges-mcp/issues"
  },
  "homepage": "https://github.com/maxxeddev/open-badges-mcp#readme"
}